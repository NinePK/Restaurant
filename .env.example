# Environment Variables
# Copy this file to .env and fill in the values

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/restaurant_db"

# JWT Secret (generate a strong random string: openssl rand -base64 64)
JWT_SECRET="change_me_to_a_long_random_secret_string_at_least_64_chars"

# Application URL (used for QR code generation)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Upload directory (relative to project root)
UPLOAD_DIR="public/uploads"

# Max file size in bytes (default 10MB)
MAX_FILE_SIZE=10485760

# Cloudinary (optional, recommended for production image storage)
# If these values are empty, the app falls back to local uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="restaurant"
